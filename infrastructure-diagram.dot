    "module.vpc.aws_vpc.this" [label="aws_vpc.this"];
  }
  "module.ec2.aws_instance.this" -> "module.vpc.aws_subnet.public";
  "module.rds.aws_db_instance.mysql" -> "data.aws_rds_engine_version.mysql";
